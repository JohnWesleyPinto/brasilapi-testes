	"item": [
		{
			"name": "CEP Valido",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code deve ser 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Resposta deve conter CEP\", function () {",
							"    const response = pm.response.json();",
							"",
							"    pm.expect(response).to.have.property(\"cep\");",
							"    pm.expect(response).to.have.property(\"state\");",
							"    pm.expect(response).to.have.property(\"city\");",
							"});",
							"",
							"pm.test(\"CEP deve ser válido\", function () {",
							"    const response = pm.response.json();",
							"",
							"    pm.expect(response.cep).to.eql(\"58297000\");",
							"});"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
